<?xml version="1.0"?>
<sdf version="1.10">
  <world name="straight_avoidance">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.78 0.85 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>7.5 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.1 -0.9</direction>
    </light>

    <!-- Road: x=0..30 m, width=2.50 m. -->
    <model name="road">
      <static>true</static>
      <pose>15.0 0 -0.025 0 0 0</pose>

      <link name="road_link">
        <collision name="road_collision">
          <geometry>
            <box>
              <size>30.0 2.50 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="road_visual">
          <geometry>
            <box>
              <size>30.0 2.50 0.05</size>
            </box>
          </geometry>

          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.14 0.14 0.14 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yellow edge lines -->
    <model name="yellow_lines">
      <static>true</static>

      <link name="lines">
        <visual name="left_yellow">
          <pose>15.0 1.0475 0.006 0 0 0</pose>

          <geometry>
            <box>
              <size>30.0 0.035 0.008</size>
            </box>
          </geometry>

          <material>
            <ambient>1 0.72 0 1</ambient>
            <diffuse>1 0.72 0 1</diffuse>
          </material>
        </visual>

        <visual name="right_yellow">
          <pose>15.0 -1.0475 0.006 0 0 0</pose>

          <geometry>
            <box>
              <size>30.0 0.035 0.008</size>
            </box>
          </geometry>

          <material>
            <ambient>1 0.72 0 1</ambient>
            <diffuse>1 0.72 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      White-line inner width = 1.95 m.
      Vehicle width = 0.78 m.
      0.78 x 2.5 = 1.95 m.

      White line thickness = 0.025 m.
      Centres at +/-0.9875 place the inner edges at +/-0.9750 m.
    -->
    <model name="white_edge_lines">
      <static>true</static>

      <link name="lines">
        <visual name="left_white">
          <pose>15.0 0.9875 0.007 0 0 0</pose>

          <geometry>
            <box>
              <size>30.0 0.025 0.009</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <visual name="right_white">
          <pose>15.0 -0.9875 0.007 0 0 0</pose>

          <geometry>
            <box>
              <size>30.0 0.025 0.009</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Road start       = x 0.0
      Start line       = x 4.0
      Finish line      = x 26.0
      Road end         = x 30.0

      Start to finish  = 22.0 m
    -->
    <model name="start_finish">
      <static>true</static>

      <link name="lines">
        <visual name="start">
          <pose>4.00 0 0.009 0 0 0</pose>

          <geometry>
            <box>
              <size>0.05 1.95 0.012</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <visual name="finish">
          <pose>26.00 0 0.009 0 0 0</pose>

          <geometry>
            <box>
              <size>0.05 1.95 0.012</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Curbs:
      height = 0.18 m
      centre Z = 0.09 m

      LiDAR centre height = 0.12 m,
      therefore the 2D LiDAR scan plane intersects the curb collision.
    -->

    <model name="left_curb">
      <static>true</static>
      <pose>15.0 1.170 0.09 0 0 0</pose>

      <link name="curb">
        <collision name="collision">
          <geometry>
            <box>
              <size>30.0 0.15 0.18</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30.0 0.15 0.18</size>
            </box>
          </geometry>

          <material>
            <ambient>0.58 0.58 0.58 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_curb">
      <static>true</static>
      <pose>15.0 -1.170 0.09 0 0 0</pose>

      <link name="curb">
        <collision name="collision">
          <geometry>
            <box>
              <size>30.0 0.15 0.18</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30.0 0.15 0.18</size>
            </box>
          </geometry>

          <material>
            <ambient>0.58 0.58 0.58 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Obstacle positions and LEFT / RIGHT order are filled by the
      launch file before Gazebo starts.
    -->

    <model name="obstacle_1">
      <static>true</static>
      <pose>9.325000 0.780 0.075 0 0 0</pose>

      <link name="box_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.65 0.39 0.15</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.65 0.39 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.72 0.18 0.08 1</ambient>
            <diffuse>0.82 0.22 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>20.675000 -0.780 0.075 0 0 0</pose>

      <link name="box_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.65 0.39 0.15</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.65 0.39 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.08 0.30 0.72 1</ambient>
            <diffuse>0.10 0.38 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
