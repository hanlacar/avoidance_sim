<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo reference="chassis_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <gazebo reference="front_left_wheel_link"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="front_right_wheel_link"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="rear_left_wheel_link"><mu1>1.3</mu1><mu2>1.3</mu2></gazebo>
  <gazebo reference="rear_right_wheel_link"><mu1>1.3</mu1><mu2>1.3</mu2></gazebo>

  <gazebo reference="laser_link">
    <sensor name="front_lidar" type="gpu_lidar">
      <topic>/scan_front</topic>
      <gz_frame_id>laser_link</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="rear_laser_link">
    <sensor name="rear_lidar" type="gpu_lidar">
      <topic>/scan_rear</topic>
      <gz_frame_id>rear_laser_link</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_steering_joint</joint_name>
      <topic>/turtle_car/front_left_steering_cmd</topic>
      <p_gain>100</p_gain><d_gain>5</d_gain>
      <cmd_min>-20</cmd_min><cmd_max>20</cmd_max>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_steering_joint</joint_name>
      <topic>/turtle_car/front_right_steering_cmd</topic>
      <p_gain>100</p_gain><d_gain>5</d_gain>
      <cmd_min>-20</cmd_min><cmd_max>20</cmd_max>
    </plugin>
    <xacro:macro name="wheel_controller" params="joint topic">
      <plugin filename="gz-sim-joint-controller-system"
              name="gz::sim::systems::JointController">
        <joint_name>${joint}</joint_name>
        <topic>${topic}</topic>
      </plugin>
    </xacro:macro>
    <xacro:wheel_controller joint="front_left_wheel_joint"
      topic="/turtle_car/front_left_wheel_cmd"/>
    <xacro:wheel_controller joint="front_right_wheel_joint"
      topic="/turtle_car/front_right_wheel_cmd"/>
    <xacro:wheel_controller joint="rear_left_wheel_joint"
      topic="/turtle_car/rear_left_wheel_cmd"/>
    <xacro:wheel_controller joint="rear_right_wheel_joint"
      topic="/turtle_car/rear_right_wheel_cmd"/>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>turtle_car</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/ground_truth/odom_world</odom_topic>
      <tf_topic>/ground_truth/tf_world</tf_topic>
    </plugin>
  </gazebo>
</robot>
